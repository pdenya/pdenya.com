{
  "name": "pdenya-hugo-site",
  "version": "1.0.1",
  "description": "Paul Denya's personal website",
  "main": "index.js",
  "scripts": {
    "dev": "hugo server -D",
    "build": "hugo",
    "deploy": "hugo && aws s3 sync public/ s3://pdenya.com --delete --profile personal",
    "invalidate": "aws cloudfront create-invalidation --distribution-id E2LKZT5VZTOWC5 --paths \"/*\" --profile personal"
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "three": "^0.175.0",
    "vanta": "^0.5.24"
  }
}
